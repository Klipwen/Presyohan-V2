<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Radiant Orange Glow -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#80FB8500" />
        </shape>
    </item>
    <!-- Pure Vibrant Orange Core -->
    <item
        android:bottom="0.5dp"
        android:left="0.5dp"
        android:right="0.5dp"
        android:top="0.5dp">
        <shape android:shape="oval">
            <solid android:color="#FB8500" />
            <stroke
                android:width="1dp"
                android:color="#FB8500" />
        </shape>
    </item>
</layer-list>

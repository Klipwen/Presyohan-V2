<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Soft Teal Glow Halo -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#80219EBC" />
        </shape>
    </item>
    <!-- Vibrant Teal Core with Neon Cyan Highlight -->
    <item
        android:bottom="0.5dp"
        android:left="0.5dp"
        android:right="0.5dp"
        android:top="0.5dp">
        <shape android:shape="oval">
            <solid android:color="#219EBC" />
            <stroke
                android:width="1dp"
                android:color="#00E5FF" />
        </shape>
    </item>
</layer-list>

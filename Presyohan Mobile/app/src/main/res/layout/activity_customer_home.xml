<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E5E5E5"
    android:fitsSystemWindows="false">

        <!-- Curved Header Container -->
        <LinearLayout
            android:id="@+id/curvedHeaderContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_category_filter"
            android:orientation="vertical"
            android:elevation="6dp"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Part 1: Menu & Logo Header -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/headerPresyohan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="2dp"
                android:paddingBottom="0dp">

                <ImageView
                    android:id="@+id/logoIcon"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="12dp"
                    android:contentDescription="Logo"
                    android:rotation="-45"
                    android:src="@drawable/icon_presyohan"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/logoText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="sans-serif"
                    android:text="presyo"
                    android:textColor="@color/presyo_orange"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@+id/logoIcon"
                    app:layout_constraintStart_toEndOf="@id/logoIcon"
                    app:layout_constraintTop_toTopOf="@+id/logoIcon"
                    app:layout_constraintVertical_bias="1.0" />

                <TextView
                    android:id="@+id/logoTextBlue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="0dp"
                    android:fontFamily="sans-serif"
                    android:text="han"
                    android:textColor="@color/presyo_teal"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@id/logoText"
                    app:layout_constraintTop_toTopOf="@id/logoText"
                    app:layout_constraintBottom_toBottomOf="@id/logoText" />

                <ImageView
                    android:id="@+id/notifIcon"
                    android:layout_width="24dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="16dp"
                    android:contentDescription="Notifications"
                    android:src="@drawable/icon_notification"
                    app:layout_constraintEnd_toStartOf="@id/profileIconContainer"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <View
                    android:id="@+id/notifDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/indicator_dot"
                    android:visibility="gone"
                    app:layout_constraintEnd_toStartOf="@id/profileIconContainer"
                    app:layout_constraintTop_toTopOf="parent" />

                <FrameLayout
                    android:id="@+id/profileIconContainer"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_avatar_border"
                    android:padding="2dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <ImageView
                        android:id="@+id/profileIcon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="Profile"
                        android:src="@drawable/avatar_default" />
                </FrameLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Header Divider and Loading Bar -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Header Divider (Visible only in Internet search mode) -->
                <View
                    android:id="@+id/headerDivider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E5E7EB"
                    android:visibility="gone" />

                <!-- Header Progress Bar (Visible only when searching online) -->
                <ProgressBar
                    android:id="@+id/headerProgressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_gravity="bottom"
                    android:minHeight="8dp"
                    android:maxHeight="8dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/presyo_teal"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Search Bar Layout -->
            <LinearLayout
                android:id="@+id/searchBarContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp"
                android:paddingTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:id="@+id/searchEditTextContainer"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_customer_search_input"
                    android:paddingStart="12dp"
                    android:paddingEnd="6dp">

                    <!-- Left Internet Icon inside input (Visible only in Internet search mode) -->
                    <ImageView
                        android:id="@+id/ivSearchInternetIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/icon_internet"
                        app:tint="@color/presyo_teal"
                        android:visibility="gone" />

                    <EditText
                        android:id="@+id/searchEditText"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="Search Item.."
                        android:textColor="#333333"
                        android:textColorHint="#999999"
                        android:textSize="14sp"
                        android:singleLine="true"
                        android:imeOptions="actionSearch" />

                    <!-- Clear Button -->
                    <ImageView
                        android:id="@+id/btnClearSearch"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:padding="8dp"
                        android:src="@drawable/ic_close_gray"
                        android:visibility="gone"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Clear Search" />

                    <!-- Inside Search Pill Button (Visible only in Internet search mode) -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnInsideSearchAction"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_button_round_teal_pill"
                        android:text="Search"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="16dp"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- Internet Search Mode Button (Globe Icon) -->
                <ImageView
                    android:id="@+id/btnInternetSearchMode"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="2dp"
                    android:padding="10dp"
                    android:src="@drawable/icon_internet"
                    app:tint="@color/presyo_teal"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Internet Price Search" />

            </LinearLayout>

        </LinearLayout>

        <!-- Top Back to Local Stores Button (Visible only in Internet search mode) -->
        <LinearLayout
            android:id="@+id/btnBackToLocalStoresTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/curvedHeaderContainer"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/icon_arrow_right"
                android:rotation="180"
                app:tint="#555555" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Back to local stores"
                android:textColor="#555555"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Internet Bottom Action Card (Visible only in Internet search mode when error/empty state occurs) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/layoutInternetBottomCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@android:color/white"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="12dp"
                android:paddingHorizontal="16dp">

                <TextView
                    android:id="@+id/tvInternetBottomCardText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="No Items Found"
                    android:textColor="#333333"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvInternetBottomCardAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Search again"
                    android:textColor="@color/presyo_orange"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Shimmer Loading for Prices -->
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerPricesContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/btnBackToLocalStoresTop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <include layout="@layout/layout_items_shimmer" />
        </com.facebook.shimmer.ShimmerFrameLayout>

        <!-- Shimmer Loading for Stores -->
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerStoresContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/btnBackToLocalStoresTop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <include layout="@layout/layout_store_shimmer" />
        </com.facebook.shimmer.ShimmerFrameLayout>

        <!-- Main Content Area -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/btnBackToLocalStoresTop"
            app:layout_constraintBottom_toBottomOf="parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Prices Tab View -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCustomerPrices"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="120dp"
                    android:scrollbars="vertical"
                    tools:listitem="@layout/item_customer_product" />

                <!-- Searching Loading State -->
                <LinearLayout
                    android:id="@+id/layoutSearchLoading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="#F8FAFC"
                    android:paddingVertical="8dp"
                    android:layout_gravity="top"
                    android:visibility="gone">

                    <ProgressBar
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="8dp"
                        android:indeterminateTint="@color/presyo_orange"
                        android:indeterminate="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Searching..."
                        android:textColor="#64748B"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Stores Tab View (Hidden by default) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCustomerStores"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="120dp"
                    android:scrollbars="vertical"
                    android:visibility="gone"
                    tools:listitem="@layout/item_customer_store" />

                <!-- Empty State -->
                <LinearLayout
                    android:id="@+id/layoutEmptyState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="gone"
                    android:padding="24dp">

                    <ImageView
                        android:id="@+id/ivEmptyStateIcon"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@drawable/icon_store"
                        app:tint="#B3B3B3"/>

                    <TextView
                        android:id="@+id/emptyStateMessage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="No linked stores or public prices found.\nUse the + button to add a store!"
                        android:textAlignment="center"
                        android:textColor="#B3B3B3"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Internet Search Full-Screen Progress Overlay -->
                <RelativeLayout
                    android:id="@+id/layoutInternetSearchProgress"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true">

                    <!-- Skeleton Loader Background -->
                    <com.presyohan.app.SkeletonLoaderView
                        android:id="@+id/internetSkeletonLoader"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <!-- Large Mascot Container for Infinity Animation -->
                        <FrameLayout
                            android:id="@+id/layoutInternetMascotContainer"
                            android:layout_width="match_parent"
                            android:layout_height="160dp">

                            <ImageView
                                android:id="@+id/imgInternetSearchMascot"
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:layout_gravity="center"
                                android:src="@drawable/icon_searching"
                                android:contentDescription="Searching Mascot" />

                        </FrameLayout>

                        <!-- Shimmering cycling text -->
                        <TextView
                            android:id="@+id/tvInternetSearchProgressSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="32dp"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="Finding the best prices..."
                            android:textColor="#B3B3B3"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                    </LinearLayout>
                </RelativeLayout>

            </FrameLayout>

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- Bottom Navigation Section -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bottomNavigationContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Nav Bar Background Card -->
            <FrameLayout
                android:id="@+id/navBarCard"
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:background="@drawable/bg_nav_bar"
                android:elevation="8dp"
                app:layout_constraintBottom_toBottomOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Left Tab: Prices -->
                    <LinearLayout
                        android:id="@+id/btnTabPrices"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true">

                        <FrameLayout
                            android:id="@+id/pricesIconContainer"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_marginBottom="8dp"
                            android:padding="14dp">

                            <ImageView
                                android:id="@+id/pricesIcon"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/icon_pricelist" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/pricesText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Prices"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#999A9A" />
                    </LinearLayout>

                    <!-- Middle space for FAB -->
                    <View
                        android:layout_width="72dp"
                        android:layout_height="match_parent" />

                    <!-- Right Tab: Stores -->
                    <LinearLayout
                        android:id="@+id/btnTabStores"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true">

                        <FrameLayout
                            android:id="@+id/storesIconContainer"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_marginBottom="8dp"
                            android:padding="14dp">

                            <ImageView
                                android:id="@+id/storesIcon"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/icon_store" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/storesText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Stores"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#999A9A" />
                    </LinearLayout>

                </LinearLayout>
            </FrameLayout>

            <!-- Centered Floating Action Button (FAB) -->
            <FrameLayout
                android:id="@+id/btnNavAdd"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:clickable="true"
                android:focusable="true"
                android:elevation="12dp"
                app:layout_constraintTop_toTopOf="@id/navBarCard"
                app:layout_constraintBottom_toBottomOf="@id/navBarCard"
                app:layout_constraintStart_toStartOf="@id/navBarCard"
                app:layout_constraintEnd_toEndOf="@id/navBarCard">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/button_round_orange" />

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_plus_white" />
            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Dimmed Background Overlay (For Bottom Sheet) -->
        <View
            android:id="@+id/dimmedBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:visibility="gone"
            android:elevation="10dp" />

        <!-- Add Store Bottom Sheet Container -->
        <LinearLayout
            android:id="@+id/addStoreBottomSheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_bottom_sheet"
            android:paddingTop="18dp"
            android:paddingBottom="24dp"
            android:paddingHorizontal="16dp"
            android:elevation="24dp"
            android:outlineAmbientShadowColor="#000000"
            android:outlineSpotShadowColor="#000000"
            android:outlineProvider="background"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Button 1: Presyohan -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnBottomSheetPresyohan"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_button_round_teal_pill"
                android:text="ADD PRESYOHAN"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Button 2: Add Suking Tindahan -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnBottomSheetAddSuki"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_button_round_orange_pill"
                android:text="ADD SUKING TINDAHAN"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />



        </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_qr_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_curve_logo"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <!-- Top Header & Close Button -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <FrameLayout
                android:id="@+id/btnClosePaywall"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="start|top"
                android:background="@drawable/bg_paywall_close_circle"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp">

                <ImageView
                    android:id="@+id/imgClosePaywall"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Close"
                    android:src="@drawable/ic_close_gray"
                    app:tint="@color/presyo_orange" />
            </FrameLayout>
        </FrameLayout>

        <!-- Main Headline -->
        <TextView
            android:id="@+id/tvPaywallHeaderSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:text="Level up your"
            android:textColor="#0284C7"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Brand Name -->
        <TextView
            android:id="@+id/tvPaywallHeaderBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="-2dp"
            android:includeFontPadding="false"
            android:text="Presyohan"
            android:textColor="@color/presyo_orange"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvPaywallSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="3dp"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="Get more AI features and connect with Partnered Suki Stores."
            android:textColor="#64748B"
            android:textSize="12sp" />

        <!-- Segmented Tab Selector (Presyohan Pro | Presyohan VIP) -->
        <LinearLayout
            android:id="@+id/layoutPaywallTabsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_paywall_tab_container"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/btnTabPro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_paywall_tab_active_orange"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:text="Presyohan Pro"
                android:textColor="@color/presyo_orange"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnTabVip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:text="Presyohan VIP"
                android:textColor="#64748B"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ViewPager2 Carousel with Page Scaling & Peek -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPagerCards"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingHorizontal="24dp"
            tools:layout="@layout/layout_paywall_tier_card" />

        <!-- Bottom Sticky Action Area -->
        <LinearLayout
            android:id="@+id/layoutBottomAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPaywallCta"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_margin="8dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/button_round"
                android:backgroundTint="@color/presyo_orange"
                android:gravity="center"
                android:includeFontPadding="false"
                android:padding="0dp"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="START 7-DAY FREE TRIAL" />

            <TextView
                android:id="@+id/tvPaywallFooterSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Cancel Anytime"
                android:textColor="#64748B"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>

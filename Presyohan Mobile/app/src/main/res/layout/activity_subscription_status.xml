<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Header bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="2dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/headerTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_header_yellow"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="Subscriptions &amp; Plans"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="16dp"
            android:contentDescription="Back"
            android:src="@drawable/icon_back"
            app:layout_constraintBottom_toBottomOf="@+id/headerTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/headerTitle"
            app:tint="@color/white" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Content Area with Shimmer Skeleton and Pull-to-Refresh -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Shimmer Skeleton Loading Container -->
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:shimmer_auto_start="true"
            app:shimmer_base_alpha="0.4"
            app:shimmer_duration="1200"
            app:shimmer_highlight_alpha="1.0"
            tools:ignore="MissingClass">

            <include layout="@layout/layout_subscription_shimmer" />

        </com.facebook.shimmer.ShimmerFrameLayout>

        <!-- Main Content Scroll with Pull to Refresh -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollViewContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp">

            <!-- Card 1: Active Subscription Overview -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_unselected"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgActiveTierIcon"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/icon_pro"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/layoutActiveHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="YOUR ACTIVE SUBSCRIPTION"
                            android:textColor="#9CA3AF"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvActiveTierName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Free Tier"
                            android:textColor="@color/presyo_orange"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvBillingEmail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Account: loading..."
                            android:textColor="#757575"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvActiveTierBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <!-- Dynamic Subscription Status Pill / Deadline Box -->
                <LinearLayout
                    android:id="@+id/layoutActiveStatusPill"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_subscription_status_pill_orange"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="9dp">

                    <ImageView
                        android:id="@+id/imgActiveStatusIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_calendar_clock"
                        app:tint="@color/presyo_orange" />

                    <TextView
                        android:id="@+id/tvActiveSubscriptionStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Expires on Oct 6, 2026 (5 days remaining)"
                        android:textColor="@color/presyo_orange"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Expired Banner Alert Box (when recent fallback happened) -->
                <LinearLayout
                    android:id="@+id/layoutExpiredNoticeBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_subscription_notice_expired"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/icon_subscriptions"
                        app:tint="@color/presyo_orange" />

                    <TextView
                        android:id="@+id/tvExpiredNoticeMessage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="Your PRO trial has expired. Renew to continue with higher limits."
                        android:textColor="#4B5563"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Active Card Quick Action Buttons (Upgrade / Cancel) -->
                <LinearLayout
                    android:id="@+id/layoutActiveCardActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnActiveUpgradeAction"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_solid_button_orange"
                        android:text="Upgrade Plan"
                        android:textColor="@color/white"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnActiveCancelAction"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_rect_outline_orange"
                        android:text="Cancel Subscription"
                        android:textColor="@color/presyo_orange"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <View
                    android:id="@+id/dividerActive"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="#E5E7EB" />

                <!-- Capacity Stats Section -->
                <TextView
                    android:id="@+id/lblCapacityStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Live Plan Capacity &amp; Usage"
                    android:textColor="#374151"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Store Limit Progress -->
                <LinearLayout
                    android:id="@+id/layoutStatStores"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Owned Stores"
                            android:textColor="#6B7280"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvStatStoresVal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1 / 1"
                            android:textColor="@color/presyo_orange"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progressStores"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="6dp"
                        android:max="100"
                        android:progress="100"
                        android:progressDrawable="@drawable/bg_indicator_active" />
                </LinearLayout>

                <!-- Items Limit Progress -->
                <LinearLayout
                    android:id="@+id/layoutStatItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Items per Store"
                            android:textColor="#6B7280"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvStatItemsVal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 / 100"
                            android:textColor="@color/presyo_orange"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progressItems"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="6dp"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/bg_indicator_active" />
                </LinearLayout>

                <!-- Members Limit Progress -->
                <LinearLayout
                    android:id="@+id/layoutStatMembers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Staff Members per Store"
                            android:textColor="#6B7280"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvStatMembersVal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1 / 3"
                            android:textColor="@color/presyo_orange"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progressMembers"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="6dp"
                        android:max="100"
                        android:progress="33"
                        android:progressDrawable="@drawable/bg_indicator_active" />
                </LinearLayout>

                <!-- AI Parser Daily Quota -->
                <LinearLayout
                    android:id="@+id/layoutStatAi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Daily AI Scans &amp; Imports"
                            android:textColor="#6B7280"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvStatAiVal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3 / 3 remaining"
                            android:textColor="@color/presyo_orange"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progressAi"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="6dp"
                        android:max="100"
                        android:progress="100"
                        android:progressDrawable="@drawable/bg_indicator_active" />
                </LinearLayout>

            </LinearLayout>

            <!-- Section Divider: Choose Plan -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#D1D5DB" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:text="Choose Presyohan Plan"
                    android:textColor="#6B7280"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#D1D5DB" />
            </LinearLayout>

            <!-- TIER 1 (TOP FEATURED): PRO TIER CARD -->
            <LinearLayout
                android:id="@+id/cardTierPro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_card_selected_orange"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Top Header Row: Icon, Title & Promo Chip -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgIconPro"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/icon_pro" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvCardTitlePro"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PRO Tier"
                            android:textColor="@color/presyo_orange"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvCardPricePro"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/presyo_orange"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                tools:text="₱100" />

                            <TextView
                                android:id="@+id/tvCardOriginalPricePro"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:textColor="#9CA3AF"
                                android:textSize="14sp"
                                android:visibility="gone"
                                tools:text="₱100" />

                            <TextView
                                android:id="@+id/tvCardPeriodPro"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="/ month"
                                android:textColor="#6B7280"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvPromoExpirationPro"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textColor="#6B7280"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:visibility="gone"
                            tools:text="Special offer valid until Nov 30, 2026" />
                    </LinearLayout>

                    <!-- Promo / Discount Chip Placeholder -->
                    <TextView
                        android:id="@+id/tvPromoBadgePro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_promo_chip_orange"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="7 DAYS TRIAL"
                        android:textColor="@color/presyo_orange"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvCardDescPro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#4B5563"
                    android:textSize="13sp"
                    tools:text="Ideal for growing single &amp; multi-branch retail stores." />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="#FED7AA" />

                <!-- Dynamic Benefits Container -->
                <LinearLayout
                    android:id="@+id/featuresPro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <!-- Populated dynamically without emojis -->
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSelectPro"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_solid_button_orange"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:padding="0dp"
                    android:text="UPGRADE TO PRO (₱100/MO)"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- TIER 2: VIP TIER CARD -->
            <LinearLayout
                android:id="@+id/cardTierVip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_card_selected_teal"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Top Header Row: Icon, Title & Promo Chip -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgIconVip"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/icon_vip" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvCardTitleVip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VIP Tier"
                            android:textColor="@color/presyo_teal"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvCardPriceVip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/presyo_teal"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                tools:text="₱299" />

                            <TextView
                                android:id="@+id/tvCardOriginalPriceVip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:textColor="#9CA3AF"
                                android:textSize="14sp"
                                android:visibility="gone"
                                tools:text="₱299" />

                            <TextView
                                android:id="@+id/tvCardPeriodVip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="/ month"
                                android:textColor="#6B7280"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvPromoExpirationVip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textColor="#6B7280"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:visibility="gone"
                            tools:text="Special offer valid until Nov 30, 2026" />
                    </LinearLayout>

                    <!-- Promo / Discount Chip Placeholder -->
                    <TextView
                        android:id="@+id/tvPromoBadgeVip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_promo_chip_teal"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="BEST VALUE"
                        android:textColor="@color/presyo_teal"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvCardDescVip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#4B5563"
                    android:textSize="13sp"
                    tools:text="Ideal for high-volume businesses &amp; enterprise managers." />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="#99F6E4" />

                <!-- Dynamic Benefits Container -->
                <LinearLayout
                    android:id="@+id/featuresVip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <!-- Populated dynamically without emojis -->
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSelectVip"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_button_rect_teal"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:padding="0dp"
                    android:text="UPGRADE TO VIP (₱299/MO)"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- TIER 3 (BOTTOM): FREE TIER CARD -->
            <LinearLayout
                android:id="@+id/cardTierFree"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card_unselected"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Top Header Row: Title & Badge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvCardTitleFree"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Free Plan"
                            android:textColor="#1F2937"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvCardPriceFree"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/presyo_orange"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                tools:text="₱0" />

                            <TextView
                                android:id="@+id/tvCardOriginalPriceFree"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:textColor="#9CA3AF"
                                android:textSize="14sp"
                                android:visibility="gone"
                                tools:text="₱0" />

                            <TextView
                                android:id="@+id/tvCardPeriodFree"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="/ forever"
                                android:textColor="#6B7280"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Promo / Badge Placeholder for Free -->
                    <TextView
                        android:id="@+id/tvPromoBadgeFree"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_promo_chip_grey"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="BASIC PLAN"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvCardDescFree"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#4B5563"
                    android:textSize="13sp"
                    tools:text="Ideal for micro sari-sari stores &amp; single vendors." />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="#E5E7EB" />

                <!-- Dynamic Benefits Container -->
                <LinearLayout
                    android:id="@+id/featuresFree"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <!-- Populated dynamically without emojis -->
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSelectFree"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_button_rect_outline_orange"
                    android:enabled="false"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:padding="0dp"
                    android:text="CURRENT PLAN"
                    android:textColor="@color/presyo_orange"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</FrameLayout>

</LinearLayout>

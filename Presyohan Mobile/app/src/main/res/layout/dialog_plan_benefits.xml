<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000"
    android:padding="20dp">

    <LinearLayout
        android:id="@+id/cardDialogContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_dialog_custom"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgTierIcon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="Tier Icon"
                android:src="@drawable/icon_pro" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTierTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/presyo_orange"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="PRO Tier Full Benefits" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvEffectivePrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/presyo_orange"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="₱50 / month" />

                    <TextView
                        android:id="@+id/tvOriginalPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textColor="#94A3B8"
                        android:textSize="12sp"
                        android:visibility="gone"
                        tools:text="₱99" />

                    <TextView
                        android:id="@+id/tvPromoBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_promo_chip_orange"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:textColor="@color/presyo_orange"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="+ 50% OFF" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPromoExpiration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#64748B"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="Special offer valid until Nov 30, 2026" />
            </LinearLayout>
        </LinearLayout>

        <!-- Description from Admin -->
        <TextView
            android:id="@+id/tvTierDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#475569"
            android:textSize="12sp"
            tools:text="Ideal for growing single &amp; multi-branch retail stores." />

        <!-- Divider -->
        <View
            android:id="@+id/dividerDialog"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="#E2E8F0" />

        <!-- Scrollable Benefits List Area -->
        <ScrollView
            android:id="@+id/scrollViewBenefits"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:maxHeight="360dp"
            android:overScrollMode="never"
            android:scrollbars="vertical">

            <LinearLayout
                android:id="@+id/layoutBenefitsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="8dp">
                <!-- Dynamically populated with all admin features -->
            </LinearLayout>
        </ScrollView>

        <!-- Action Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnGotIt"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/button_round"
            android:backgroundTint="@color/presyo_orange"
            android:gravity="center"
            android:includeFontPadding="false"
            android:padding="0dp"
            android:text="GOT IT"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_custom"
    android:orientation="vertical"
    android:padding="18dp"
    android:gravity="center_horizontal">

    <!-- Title: Store Details -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Store Details"
        android:textColor="@color/presyo_orange"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <!-- Store Summary Header Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_store_details_card"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <!-- Store Icon -->
        <ImageView
            android:id="@+id/dialogStoreIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/icon_store"
            android:layout_marginEnd="12dp"
            android:contentDescription="Store Logo"/>

        <!-- Store Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Store Name -->
            <TextView
                android:id="@+id/dialogStoreName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Store Name"
                android:textColor="@color/presyo_darkblue"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Store Category -->
            <TextView
                android:id="@+id/dialogStoreCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Store Category"
                android:textColor="@color/presyo_teal"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />

            <!-- Branch Location -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_location"
                    app:tint="#64748B"
                    android:layout_marginEnd="3dp" />

                <TextView
                    android:id="@+id/dialogStoreBranch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Branch Location"
                    android:textColor="#64748B"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Stats Frame Layout containing Shimmer and Actual Table -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp">

        <!-- Shimmer Skeleton Loading -->
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/dialogShimmerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_store_details_card"
                android:padding="12dp">

                <View android:layout_width="match_parent" android:layout_height="16dp" android:background="#F1F5F9" android:layout_marginBottom="8dp" />
                <View android:layout_width="match_parent" android:layout_height="16dp" android:background="#F1F5F9" android:layout_marginBottom="8dp" />
                <View android:layout_width="match_parent" android:layout_height="16dp" android:background="#F1F5F9" android:layout_marginBottom="8dp" />
                <View android:layout_width="match_parent" android:layout_height="16dp" android:background="#F1F5F9" android:layout_marginBottom="8dp" />
                <View android:layout_width="match_parent" android:layout_height="16dp" android:background="#F1F5F9" />
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>

        <!-- Actual Table Layout -->
        <TableLayout
            android:id="@+id/dialogStatsTable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="1"
            android:background="@drawable/bg_store_details_card"
            android:padding="12dp"
            android:visibility="gone">

            <!-- Store ID -->
            <TableRow android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Store ID:"
                    android:textColor="#64748B"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/dialogStoreId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="----"
                    android:textColor="#334155"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="end" />
            </TableRow>

            <!-- Status -->
            <TableRow android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status:"
                    android:textColor="#64748B"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/dialogVisibilityStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="----"
                    android:textColor="#334155"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="end" />
            </TableRow>

            <!-- Created at -->
            <TableRow android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Created at:"
                    android:textColor="#64748B"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/dialogCreatedAt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-----"
                    android:textColor="#334155"
                    android:textSize="13sp"
                    android:gravity="end" />
            </TableRow>

            <!-- Categories -->
            <TableRow android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Categories:"
                    android:textColor="#64748B"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/dialogCategoriesCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="----"
                    android:textColor="@color/presyo_orange"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="end" />
            </TableRow>

            <!-- Items -->
            <TableRow android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Public Items:"
                    android:textColor="#64748B"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/dialogItemsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="----"
                    android:textColor="@color/presyo_teal"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="end" />
            </TableRow>

            <!-- Suki -->
            <TableRow>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/icon_people"
                        app:tint="#64748B"
                        android:layout_marginEnd="4dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Suki:"
                        android:textColor="#64748B"
                        android:textSize="13sp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/dialogSukiCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="----"
                    android:textColor="@color/presyo_orange"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="end" />
            </TableRow>

        </TableLayout>
    </FrameLayout>

    <!-- BACK Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/button_round"
        android:backgroundTint="@color/presyo_orange"
        android:text="BACK"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:textSize="15sp" />

</LinearLayout>

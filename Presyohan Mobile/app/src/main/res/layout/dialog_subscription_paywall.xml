<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_qr_screen"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_curve_logo"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp">

        <!-- Top Header & Close Button -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <FrameLayout
                android:id="@+id/btnClosePaywall"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="start|top"
                android:background="@drawable/bg_btn_orange_outline"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_close_gray"
                    app:tint="@color/presyo_orange" />
            </FrameLayout>
        </FrameLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="2dp">

                <!-- Main Headline -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Level up your"
                    android:textColor="#0284C7"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-4dp"
                    android:text="Presyohan"
                    android:textColor="@color/presyo_orange"
                    android:textSize="38sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="Get more AI features and connect with Partnered Suki Stores."
                    android:textColor="#64748B"
                    android:textSize="12sp" />

                <!-- Segmented Plan Switcher Tabs -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnTabPro"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_orange_outline"
                        android:gravity="center"
                        android:text="Presyohan Pro ⭐"
                        android:textColor="@color/presyo_orange"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnTabVip"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_rounded_grey"
                        android:gravity="center"
                        android:text="Presyohan VIP 💎"
                        android:textColor="@color/presyo_orange"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Vertical Stacked Benefit Cards Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical">

                    <!-- Card 1: Store & Merchant Features -->
                    <LinearLayout
                        android:id="@+id/cardPaywallMerchant"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_paywall_merchant_card"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvMerchantSectionHeader"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🏬 STORE OWNER &amp; MERCHANT FEATURES"
                            android:textColor="#D97706"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <!-- Item 1: Stores -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvCheckMerchant1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✓ "
                                android:textColor="#D97706"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvMerchantStoresTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Store Branches"
                                    android:textColor="#D97706"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvMerchantStoresSub"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Up to 10 Stores"
                                    android:textColor="#92400E"
                                    android:textSize="10sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Item 2: Items -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvCheckMerchant2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✓ "
                                android:textColor="#D97706"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvMerchantItemsTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Item Catalog Capacity"
                                    android:textColor="#D97706"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvMerchantItemsSub"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="500 items / store branch"
                                    android:textColor="#92400E"
                                    android:textSize="10sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Item 3: Staff -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvCheckMerchant3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✓ "
                                android:textColor="#D97706"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvMerchantStaffTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Staff Accounts"
                                    android:textColor="#D97706"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvMerchantStaffSub"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="10 staffs / store branch"
                                    android:textColor="#92400E"
                                    android:textSize="10sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Item 4: AI Parser -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvCheckMerchant4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✓ "
                                android:textColor="#D97706"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvMerchantAiTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="AI Price Parser"
                                    android:textColor="#D97706"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvMerchantAiSub"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="10 AI parses / day"
                                    android:textColor="#92400E"
                                    android:textSize="10sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Item 5: Photo Scan -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvCheckMerchant5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✓ "
                                android:textColor="#D97706"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvMerchantPhotoTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Photo Scan Price List"
                                    android:textColor="#D97706"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvMerchantPhotoSub"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="10 photo scans / day"
                                    android:textColor="#92400E"
                                    android:textSize="10sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Item 6: Store Suki Access -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvCheckMerchant6"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✓ "
                                android:textColor="#D97706"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvMerchantSukiTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Suki Network Access"
                                    android:textColor="#D97706"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvMerchantSukiSub"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Connect partner stores"
                                    android:textColor="#92400E"
                                    android:textSize="10sp" />
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Card 2: Customer & Suki Partner Features -->
                    <LinearLayout
                        android:id="@+id/cardPaywallCustomer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_paywall_merchant_card"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvCustomerSectionHeader"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🤝 CUSTOMER &amp; SUKI PARTNER FEATURES"
                            android:textColor="#D97706"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <!-- Item 1: Suki -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvCheckCustomer1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✓ "
                                android:textColor="#D97706"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvCustomerSukiTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Suking Tindahan Partners"
                                    android:textColor="#D97706"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvCustomerSukiSub"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="15 partner stores"
                                    android:textColor="#92400E"
                                    android:textSize="10sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Item 2: Stores -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvCheckCustomer2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✓ "
                                android:textColor="#D97706"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvCustomerStoresTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Presyohan Stores Access"
                                    android:textColor="#D97706"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvCustomerStoresSub"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="15 Presyohan Stores"
                                    android:textColor="#92400E"
                                    android:textSize="10sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Item 3: AI Search -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvCheckCustomer3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✓ "
                                android:textColor="#D97706"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvCustomerAiSearchTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="AI Online Price Search"
                                android:textColor="#D97706"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>

                <!-- View Full Benefits Button -->
                <TextView
                    android:id="@+id/btnViewFullBenefits"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_rounded_grey"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="View Full Benefits"
                    android:textColor="#475569"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Expandable Full Benefits Layout -->
                <LinearLayout
                    android:id="@+id/layoutFullBenefits"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#F1F5F9"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓ Store Item Price Cloning &amp; Catalog Imports"
                        android:textColor="#334155"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="✓ Convert Pricelists to Excel (.xlsx) &amp; PDF"
                        android:textColor="#334155"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="✓ Priority AI Parsing &amp; Voice Commands"
                        android:textColor="#334155"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Price Box Container -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_paywall_price_box"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="10dp">

                    <TextView
                        android:id="@+id/tvPaywallPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₱100.00 / month"
                        android:textColor="@color/presyo_orange"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPaywallPriceSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Includes 7-Day Free Trial"
                        android:textColor="#64748B"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Current Plan Subtitle -->
                <TextView
                    android:id="@+id/tvCurrentPlanDropdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Current plan: Free tier ∨"
                    android:textColor="#64748B"
                    android:textSize="12sp" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Primary CTA Button & Subtitle (Round Button matching Splash screen) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnStartTrial"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/button_round"
                app:backgroundTint="@color/presyo_teal"
                android:gravity="center"
                android:includeFontPadding="false"
                android:padding="0dp"
                android:text="START 7-DAY TRIAL FOR PRO"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Cancel Anytime"
                android:textColor="#64748B"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</RelativeLayout>


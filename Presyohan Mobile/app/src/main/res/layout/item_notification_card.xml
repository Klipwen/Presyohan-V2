<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_rounded"
    android:padding="16dp"
    android:layout_marginTop="6dp"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:gravity="center_vertical"
    android:elevation="2dp">

    <!-- Left Content Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Title, Status, Timestamp Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <TextView
                android:id="@+id/textType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Store Invitation"
                android:textColor="@color/presyo_orange"
                android:textStyle="bold"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/dividerTypeStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" | "
                android:textColor="#94A3B8"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Accepted"
                android:textColor="@color/presyo_teal"
                android:textStyle="bold"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/dotSeparator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" • "
                android:textColor="#94A3B8"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="now"
                android:textColor="#64748B"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Message Body -->
        <TextView
            android:id="@+id/textMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="You invited Caliph Juen to join on your store QSOS as a Manager. Please wait for their response"
            android:textColor="#64748B"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

        <!-- Bottom Link Action (e.g. View Store) -->
        <TextView
            android:id="@+id/btnViewStore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="View Store >"
            android:textColor="@color/presyo_teal"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Orange Dot indicator (New/Unread) -->
    <View
        android:id="@+id/viewOrangeDot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/bg_orange_dot"
        android:visibility="gone" />

    <!-- Vertical Divider Line -->
    <View
        android:id="@+id/layoutDivider"
        android:layout_width="1dp"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="#E2E8F0"
        android:visibility="gone" />

    <!-- Right Action Buttons Column -->
    <LinearLayout
        android:id="@+id/layoutActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <!-- Reject Action -->
        <TextView
            android:id="@+id/btnReject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reject"
            android:textColor="#64748B"
            android:textStyle="bold"
            android:textSize="14sp"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

        <!-- Accept Action -->
        <TextView
            android:id="@+id/btnAccept"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Accept"
            android:textColor="@color/presyo_orange"
            android:textStyle="bold"
            android:textSize="14sp"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

        <!-- Cancel Request / Invitation Action -->
        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel Invitation"
            android:textColor="#64748B"
            android:textStyle="bold"
            android:textSize="14sp"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_card_unselected"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Circular Avatar -->
        <ImageView
            android:id="@+id/imgSukiAvatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/avatar_default"
            android:scaleType="centerCrop"
            android:layout_marginEnd="12dp"
            android:contentDescription="Suki Avatar" />

        <!-- Suki Info Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Name -->
            <TextView
                android:id="@+id/tvSukiName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Customer Name"
                android:textColor="@color/presyo_darkblue"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Customer ID / User Code -->
            <TextView
                android:id="@+id/tvSukiSubDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID: US-0000"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:layout_marginTop="1dp" />

            <!-- Suki since MM/DD/YY -->
            <TextView
                android:id="@+id/tvSukiSince"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Suki since --/--/--"
                android:textColor="@color/presyo_teal"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Right Side: Status Badge & Action Buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end|center_vertical"
            android:layout_marginStart="8dp">

            <!-- Status Badge -->
            <TextView
                android:id="@+id/tvSukiStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Active"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_teal"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:layout_marginBottom="6dp" />

            <!-- Action Buttons Container -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Accept Button (Visible for Pending Suki Requests) -->
                <ImageView
                    android:id="@+id/btnAcceptSuki"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:src="@drawable/ic_checkmark"
                    android:padding="8dp"
                    android:background="@drawable/bg_btn_teal_outline"
                    app:tint="@color/presyo_teal"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="Accept Request" />

                <!-- Remove / Delete Button -->
                <ImageView
                    android:id="@+id/btnRemoveSuki"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:src="@drawable/icon_delete"
                    android:padding="8dp"
                    android:background="@drawable/bg_outline_button_teal"
                    app:tint="@color/presyo_teal"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Remove Suki" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_card_unselected"
    android:padding="12dp">

    <!-- Store Icon Left -->
    <ImageView
        android:id="@+id/ivStoreIcon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/icon_store"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Store Details Center -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/ivStoreIcon"
        app:layout_constraintEnd_toStartOf="@id/layoutEndStates">

        <TextView
            android:id="@+id/tvStoreName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QSOS"
            android:textColor="@color/presyo_darkblue"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStoreType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="General Merchandise"
            android:textColor="@color/presyo_teal"
            android:textSize="13sp"
            android:layout_marginTop="2dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp">

            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@drawable/icon_branch"
                app:tint="#94A3B8" />

            <TextView
                android:id="@+id/tvStoreBranch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Main Branch"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:layout_marginStart="3dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Badge & Selection Right -->
    <LinearLayout
        android:id="@+id/layoutEndStates"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end|center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvPrivateBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Private"
            android:textColor="#64748B"
            android:textSize="9sp"
            android:textStyle="bold"
            android:background="@drawable/bg_badge_grey"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/ivSelectIndicator"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_radio_unchecked"
            app:tint="@color/presyo_orange" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

                <View
                    android:id="@+id/s2_name"
                    android:layout_width="160dp"
                    android:layout_height="18dp"
                    android:layout_marginTop="4dp"
                    android:background="#D1D5DB"
                    app:layout_constraintStart_toStartOf="parent"
